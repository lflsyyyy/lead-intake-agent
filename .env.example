# Copy to .env and fill in. Every secret can be given inline (NAME=...) or as a file (NAME_FILE=path).
# build.py reads secrets only to create n8n credentials; they are never written into workflows.
# For the Docker demo you need none of this: docker.env (mocks, Mailpit) is used with --target docker.

# --- n8n ---
N8N_URL=http://127.0.0.1:5678
N8N_API_KEY=                      # Settings -> n8n API -> Create API key
# N8N_INTERNAL_URL=               # the n8n API as n8n itself reaches it, if different from N8N_URL

# --- LLM: any OpenAI-compatible Chat Completions endpoint (primary + secondary provider) ---
LLM_BASE_URL=https://api.groq.com/openai/v1     # or https://api.openai.com/v1, https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_REASONING_EFFORT=low                        # only for reasoning models that accept it; leave empty otherwise
# Second provider, used when the primary fails (429/5xx/invalid JSON after retries)
LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_FALLBACK_API_KEY=
# Local/dev only: bridge/claude_bridge.py exposes a logged-in Claude CLI as an OpenAI-compatible endpoint
# LLM_FALLBACK_BASE_URL=http://127.0.0.1:41220/v1
# LLM_FALLBACK_MODEL=haiku
# LLM_FALLBACK_API_KEY_FILE=bridge/.key

# --- HubSpot (private app / service key with crm.objects.contacts.* and crm.objects.deals.*) ---
HUBSPOT_TOKEN=
# HUBSPOT_BASE_URL=https://api.hubapi.com      # the portal id for deep links is read from the API at run time

# --- Telegram owner alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                 # stored sealed (AES-256-GCM) in the Config node, never in plain text

# --- Email (Resend) ---
RESEND_API_KEY=
MAIL_FROM=Brightline Studio <hello@yourdomain.com>   # goes into the LIA · Resend credential, not the workflow
MAIL_REPLY_TO=
# Safety rule: only addresses matching this regex are really emailed; everything else is written
# to the lia_outbox table instead. Resend's test inbox accepts delivered+anything@resend.dev.
REAL_INBOX_REGEX=^delivered(\+[a-z0-9._-]+)?@resend\.dev$

# --- Webhook security ---
WEBHOOK_AUTH=hmac                 # hmac (X-Signature over timestamp + raw body) | token (X-Lead-Token) | none
# WEBHOOK_SECRET=                 # default: generated once into secrets/webhook.key
SIGNATURE_TOLERANCE_S=300         # replay window for signed requests
RATE_LIMIT_MAX=5                  # submissions per email or client IP ...
RATE_LIMIT_WINDOW_MIN=10          # ... per this many minutes, then 429

# --- Output gate (what an automatic reply may contain) ---
LINK_ALLOWLIST=                   # comma-separated domains replies may link to (the lead's own site is always allowed)
ALLOWED_PRICE_TERMS=              # comma-separated phrases about price that are fine, e.g. "free 30-minute call"

# --- Business context for the qualifier ---
BUSINESS_NAME=Brightline Studio
BUSINESS_PROFILE=A small web and automation studio. We build marketing websites, Shopify stores, and workflow automation (n8n, CRM integrations) for small and mid-sized businesses. Typical projects are $3k-$30k; we do not do SEO link building, app store apps, or staff outsourcing.
SENDER_NAME=Alex, Brightline Studio

# --- Behaviour ---
WEBHOOK_PATH=leads
FORM_PATH=lia-contact
DEDUPE_WINDOW_MIN=10
FOLLOWUP_DAYS=2,5
DEMO_FAST=0                       # 1 = follow-up "days" become minutes and the scheduler runs every minute
