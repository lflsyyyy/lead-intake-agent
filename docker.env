# Settings for the Docker stack (python tools/... --target docker). Safe to commit: nothing here is real.
# n8n reaches the other services by their compose names (mock, mailpit); the tools on your machine use localhost.

# --- n8n (owner and API key are created by tools/bootstrap_n8n.py on the first build) ---
N8N_URL=http://localhost:5678
N8N_INTERNAL_URL=http://localhost:5678
N8N_API_KEY_FILE=.docker/n8n-api.key
N8N_OWNER_EMAIL=owner@example.com
N8N_OWNER_PASSWORD=LocalDemo-only-1

# --- LLM: the mock's deterministic qualifier ---
LLM_BASE_URL=http://mock:8090/v1
LLM_MODEL=mock-qualifier
LLM_API_KEY=mock-key
LLM_REASONING_EFFORT=
LLM_FALLBACK_BASE_URL=http://mock:8090/v1
LLM_FALLBACK_MODEL=mock-fallback
LLM_FALLBACK_API_KEY=mock-key

# --- HubSpot, Telegram, email: all mocks; emails land in Mailpit ---
HUBSPOT_BASE_URL=http://mock:8090/hubspot
HUBSPOT_TOOLS_URL=http://localhost:8090/hubspot
HUBSPOT_TOKEN=mock-token
TELEGRAM_BASE_URL=http://mock:8090/telegram
TELEGRAM_BOT_TOKEN=000000:mock-token
TELEGRAM_CHAT_ID=424242
RESEND_BASE_URL=http://mock:8090/resend
RESEND_API_KEY=mock-key
REAL_INBOX_REGEX=.+

# --- webhook security and private settings (generated on first build, gitignored) ---
WEBHOOK_AUTH=hmac
WEBHOOK_SECRET_FILE=.docker/webhook.key
PRIVATE_SETTINGS_PASSPHRASE_FILE=.docker/private-settings.key

# --- behaviour ---
DEMO_FAST=1
