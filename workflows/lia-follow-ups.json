    {
      "id": "8d4040f1-3f09-4bc8-8649-3629406a7ff2",
      "name": "HubSpot · log follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "position": [
        3120,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/notes",
        "options": {
          "timeout": 30000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ properties: { hs_timestamp: $now.toISO(), hs_note_body: '<p><strong>Automatic follow-up #' + $json.step + '</strong> ' + ($json.note === 'emailed' ? 'sent' : 'saved to outbox') + ': ' + $json.subject + '</p>' }, associations: [{ to: { id: $json.contact_id }, types: [{ associationCategory: 'HUBSPOT_DEFINED', associationTypeId: 202 }] }] }) }}"
      },
      "credentials": {
        "hubspotAppToken": {
          "id": "REPLACE_ME",
          "name": "LIA · HubSpot"
        }
      }
    },
    {
      "id": "6302847d-b001-42a8-9864-f15e2b63b6ca",
      "name": "Compose follow-up alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3360,
        100
      ],
      "parameters": {
        "jsCode": "const esc = t => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst rows = $('Mark follow-up sent').all().map(i => i.json);\nconst lines = rows.map(r => `• #${r.step} → ${esc(r.name || r.email)}${r.company ? ' (' + esc(r.company) + ')' : ''}: ${r.note === 'emailed' ? 'sent' : 'saved to outbox'}`);\nreturn [{ json: { text: `↩️ <b>Follow-ups: ${rows.length}</b>\\n` + lines.join('\\n') } }];"
      }
    },
    {
      "id": "3e6d074e-9889-4c04-812b-8661acc2672a",
      "name": "Telegram · follow-ups sent",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "position": [
        3600,
        100
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Config').first().json.telegram_chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML",
          "disable_web_page_preview": true
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "LIA · Telegram"
        }
      },
      "webhookId": "7582132d-ed81-4c90-8b86-34e0d4835ffc"
    },
    {
      "id": "887f36a0-182b-4292-b22c-f541ea66fa99",
