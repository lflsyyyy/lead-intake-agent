    {
      "id": "f745024c-a20d-4831-a29e-5ea85ce23844",
      "name": "Still waiting for a reply?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        100
      ],
      "parameters": {
        "jsCode": "// Send only if nobody touched the lead: same HubSpot lead status as when we queued it, and no reply logged.\nconst due = $('Get due follow-ups').all();\nreturn $input.all().map((it, i) => {\n  const fu = due[i].json;\n  const props = it.json.properties || {};\n  const replied = props.hs_sales_email_last_replied && new Date(props.hs_sales_email_last_replied) > new Date(fu.createdAt);\n  const status = props.hs_lead_status || '';\n  const stop_reason = !it.json.id ? 'contact not found in HubSpot'\n    : replied ? 'lead replied'\n    : status !== fu.expected_status ? `lead status changed to ${status || 'empty'}` : '';\n  return { json: { ...fu, followup_id: String(fu.id), send: !stop_reason, stop_reason } };\n});"
      }
    },
    {
      "id": "4871c177-b1b0-4718-b44d-2a54aa540211",
      "name": "Send it?",
      "type": "n8n-nodes-base.if",
