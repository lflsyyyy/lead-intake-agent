    {
      "id": "e83e2d82-5e24-59ea-ace6-fcfb63805654",
      "name": "HubSpot · read contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput",
      "position": [
        720,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.hubspot_base_url }}/crm/v3/objects/contacts/{{ $json.contact_id }}?properties=hs_lead_status,hs_sales_email_last_replied",
        "options": {
          "timeout": 30000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken"
      },
      "credentials": {
        "hubspotAppToken": {
          "id": "REPLACE_ME",
          "name": "LIA · HubSpot"
        }
      }
    },
    {
      "id": "33d76ee6-066c-53af-9bb2-15b3569751e1",
      "name": "Still waiting for a reply?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        100
      ],
      "parameters": {
        "jsCode": "// Send only if nobody touched the lead: same HubSpot lead status as when we queued it, and no reply logged.\nconst due = $('Get due follow-ups').all();\nreturn $input.all().map((it, i) => {\n  const fu = due[i].json;\n  const props = it.json.properties || {};\n  const replied = props.hs_sales_email_last_replied && new Date(props.hs_sales_email_last_replied) > new Date(fu.createdAt);\n  const status = props.hs_lead_status || '';\n  const stop_reason = !it.json.id ? 'contact not found in HubSpot'\n    : replied ? 'lead replied'\n    : status !== fu.expected_status ? `lead status changed to ${status || 'empty'}` : '';\n  return { json: { ...fu, followup_id: String(fu.id), send: !stop_reason, stop_reason } };\n});"
      }
    },
    {
      "id": "e6aecba4-c924-53fa-b836-4ba52491085f",
      "name": "Send it?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "70092789-1d15-5243-a0f6-5d8a667f2836",
              "leftValue": "={{ $json.send }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c11a16df-2e10-5edd-89f1-92923ec709d2",
      "name": "Write follow-up email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map(it => ({ json: { lead_id: it.json.lead_id, followup_id: it.json.followup_id,\n  contact_id: it.json.contact_id, kind: `follow-up #${it.json.step}`, to: it.json.email,\n  subject: it.json.subject, body: it.json.body } }));"
      }
    },
