    {
      "id": "da22acc9-c2d5-4245-9196-0b712bb36bee",
      "name": "Describe failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const e = $('Error trigger').first().json;\nreturn [{ json: {\n  workflow: e.workflow?.name || '', workflow_id: String(e.workflow?.id || ''),\n  node: e.execution?.lastNodeExecuted || e.execution?.error?.node?.name || e.trigger?.error?.node?.name || 'trigger',\n  error: String(e.execution?.error?.message || e.trigger?.error?.message || 'unknown error').slice(0, 1000),\n  execution_id: String(e.execution?.id || ''), execution_url: e.execution?.url || '',\n} }];"
      }
    },
    {
      "id": "97cd4e1e-2d7a-4d20-bd4b-ec345621f187",
      "name": "n8n · fetch failed run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.n8n_api_url }}/executions/{{ $json.execution_id }}?includeData=true",
        "options": {
          "timeout": 30000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "n8nApi"
      },
      "credentials": {
        "n8nApi": {
          "id": "REPLACE_ME",
          "name": "LIA · n8n API"
        }
      }
    },
    {
      "id": "105b85da-e28e-48f3-9923-13ad39b7c02a",
      "name": "Extract payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "// Pull the original trigger payload out of the failed execution so it can be replayed later.\nconst f = $('Describe failure').first().json;\nconst ex = $input.first().json || {};\nconst run = ex?.data?.resultData?.runData || {};\nconst out = n => run[n]?.[0]?.data?.main?.[0]?.[0]?.json;\nlet payload = null;\nif (out('Internal trigger')) payload = out('Internal trigger').payload ?? null;\nelse if (out('Lead webhook')) {\n  const w = out('Lead webhook');\n  payload = { ...(w.body || {}) };\n  for (const [k, v] of Object.entries(w.query || {})) if (k.startsWith('utm_') && !(k in payload)) payload[k] = v;\n} else if (out('Lead form')) {\n  const { submittedAt, formMode, ...fields } = out('Lead form');\n  payload = fields;\n}\nconst lead_id = out('Normalize & validate')?.lead_id || '';\nreturn [{ json: { ...f, lead_id, payload: payload ? JSON.stringify(payload) : '', replayable: !!payload } }];"
      }
    },
