    {
      "id": "c5481def-ea76-50cc-a371-a7cd2179a8e0",
      "name": "Compose alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "jsCode": "const d = $('Extract payload').first().json;\nconst dl = $('Save dead letter').first().json;\nconst esc = t => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst text = [\n  `⚠️ LIA failed at <b>${esc(d.node)}</b>: ${esc(d.error.slice(0, 300))}`,\n  `Workflow: ${esc(d.workflow)} · execution ${esc(d.execution_id)}`,\n  d.lead_id ? `Lead: ${esc(d.lead_id)}` : '',\n  `Dead letter #${dl.id}` + (d.replayable ? ': nothing is lost, run “LIA · Replay dead letters” to retry.' : '.'),\n].filter(Boolean).join('\\n');\nreturn [{ json: { text } }];"
      }
    },
