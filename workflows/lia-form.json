      "parameters": {
        "jsCode": "// n8n forms cannot share a workflow with \"Respond to Webhook\", so the form is a thin adapter into Intake.\nconst { submittedAt, formMode, ...fields } = $input.first().json;\nreturn [{ json: { channel: 'form', payload: { ...fields, source: 'website form' } } }];"
