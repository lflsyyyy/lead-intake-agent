    {
      "id": "3640a08f-ff8d-51b7-a899-1cb1b411608f",
      "name": "Prepare replay",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  const d = it.json;\n  if (d.id == null || !d.payload) continue;\n  let payload;\n  try { payload = JSON.parse(d.payload); } catch (e) { continue; }\n  out.push({ json: { payload, channel: 'replay', replay_of: d.id, attempts: Number(d.attempts || 0) } });\n}\nreturn out;"
      }
    },
